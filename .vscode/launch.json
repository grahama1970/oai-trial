{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pitch: identity",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pitch_debug_demo.py",
      "args": [
        "identity"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pitch: typed",
