        "typed"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pitch: publication",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pitch_debug_demo.py",
      "args": [
        "publication"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
