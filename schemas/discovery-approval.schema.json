{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit exact-policy compilation receipt; not release authorization",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "approved_ids", "source_policy_sha256", "source_corpus_sha256", "policy_sha256", "release_ready", "seam_validation"],
  "properties": {
    "schema": {"const": "anon.discovery_approval.v1"},
    "approved_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{24}$"}},
    "source_policy_sha256": {"$ref": "#/$defs/digest"},
    "source_corpus_sha256": {"$ref": "#/$defs/digest"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "release_ready": {"const": false},
    "seam_validation": {"const": {"kind": "compiled_policy", "status": "PASS"}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
